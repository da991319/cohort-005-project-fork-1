{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "vitest"],
  "jsPlugins": ["./lint-rules/sql-raw.js"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["drizzle/**", ".agents/**", ".claude/**"],
  "rules": {
    // Correctness rules that go beyond the coding standards.
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off",

    // The coding standards, translated from the ESLint plan.
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-var": "error",
    "prefer-const": "error",
    "no-console": [
      "error",
      {
        "allow": ["error"]
      }
    ],
    "no-throw-literal": "error",
    "no-useless-catch": "error",
    "prefer-arrow-callback": "error",
    "max-lines": [
      "error",
      {
        "max": 500,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 50,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-params": ["error", 3],
    "max-depth": ["error", 3],
    "id-denylist": [
      "error",
      "req",
      "res",
      "e",
      "err",
      "ctx",
      "btn",
      "msg",
      "val"
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "error",
    "react/jsx-no-target-blank": "error",
    "react/no-danger": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/no-autofocus": [
      "error",
      {
        "ignoreNonDOM": true
      }
    ],
    "import/no-default-export": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-focused-tests": "error",
    "sql/no-dynamic-raw": "error"
  },
  "overrides": [
    {
      "files": [
        "app/routes/**",
        "app/root.tsx",
        "app/routes.ts",
        "*.config.*",
        "*.conf.*",
        "lint-rules/**"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["scripts/**", "request-logger/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["request-logger/render.ts", "request-logger/render.test.ts"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
